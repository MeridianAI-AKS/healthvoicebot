# Local dev uses the Vite proxy (/api -> http://localhost:8000), so leave unset.
# VITE_API_BASE_URL=/api
# Only if the backend sets CLIENT_KEY (required for the Speech token endpoint):
# VITE_CLIENT_KEY=

# Backend origin for the dev proxy. Use 127.0.0.1 (not localhost) on Windows.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
