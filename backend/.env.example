# ── Azure OpenAI (chat) ───────────────────────────────────────────────
# Full deployment URL including the api-version query string.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-08-01-preview
AZURE_OPENAI_KEY=

# ── Azure OpenAI (embeddings, optional) ───────────────────────────────
# Without these the agent still works; retrieval falls back to BM25 keyword search.
AZURE_OPENAI_BASE=https://<resource>.openai.azure.com
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-02-01

# ── Azure Speech (voice mode, optional) ───────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ── App ───────────────────────────────────────────────────────────────
# Comma-separated. Leave empty for open CORS in local dev only.
CORS_ORIGINS=http://localhost:5173

# Set this and the frontend must send X-Client-Key to mint Speech tokens.
# Leave empty for local dev; set it for anything deployed.
CLIENT_KEY=

MAX_TOOL_ROUNDS=4
CHAT_MAX_TOKENS=450

# Build the 71MB embedding index on first start (App Service /home is persistent).
# BUILD_INDEX_ON_STARTUP=true
